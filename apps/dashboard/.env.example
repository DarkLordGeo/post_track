DATABASE_URL="postgresql://postgres:postgres@localhost:54329/post_tracker"
# Public URL of this dashboard (used in API responses for deep links).
APP_URL="http://localhost:3000"
# Optional: Reddit "script"/"web" app credentials (https://www.reddit.com/prefs/apps) enable
# server-side engagement collection. Without them, snapshots come only from the extension.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="web:post-tracker:0.1.0 (local development)"
