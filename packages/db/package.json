{
  "name": "@post-tracker/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "node scripts/dev-db.mjs",
    "generate": "prisma generate",
    "push": "prisma db push --skip-generate",
    "typecheck": "tsc -p tsconfig.json",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@post-tracker/core": "workspace:*",
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "embedded-postgres": "17.11.0-beta.19",
    "prisma": "6.19.3"
  }
}
